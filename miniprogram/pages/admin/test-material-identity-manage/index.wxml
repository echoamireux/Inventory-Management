<view class="identity-page">
  <view class="identity-header">
    <view class="identity-header__text">
      <view class="identity-title">测试料型号库</view>
      <view class="identity-hint">测试料入库、预打印和模板导入只能选择已启用型号；停用不影响历史库存查询。</view>
    </view>
    <view class="identity-actions identity-actions--single">
      <view class="identity-action">
        <van-button block size="small" round type="primary" bind:click="onCreateIdentity">新增</van-button>
      </view>
    </view>
  </view>

  <van-search
    value="{{ searchVal }}"
    placeholder="测试料：产品代码/原厂型号/物料名等"
    shape="round"
    bind:change="onSearchChange"
    bind:search="onSearchConfirm"
    bind:clear="onClearSearch"
    custom-class="search-compact"
  />

  <van-notice-bar
    wx:if="{{ searchMessage }}"
    left-icon="info-o"
    text="{{ searchMessage }}"
    color="#1d4ed8"
    background="#eef6ff"
  />

  <view wx:if="{{ loading && identities.length === 0 }}" class="identity-loading">
    <van-loading type="spinner" vertical>加载中...</van-loading>
  </view>

  <van-empty wx:elif="{{ identities.length === 0 }}" description="暂无测试料型号" />

  <view wx:else class="identity-list">
    <view
      wx:for="{{ identities }}"
      wx:key="identity_key"
      class="identity-card {{ item.status === 'disabled' ? 'identity-card--disabled' : '' }}"
    >
      <view class="identity-card__main">
        <view class="identity-card__top">
          <text class="identity-model">{{ item.supplier_model || '-' }}</text>
          <view class="identity-card__tags">
            <van-tag wx:if="{{ item.category === 'chemical' }}" plain type="primary">化材</van-tag>
            <van-tag wx:else plain type="success">膜材</van-tag>
            <van-tag wx:if="{{ item.status === 'disabled' }}" plain color="#6b7280">已停用</van-tag>
            <van-tag wx:else plain type="success">已启用</van-tag>
          </view>
        </view>
        <view class="identity-name">{{ item.label_material_name || item.material_name || '未命名测试料' }}</view>
        <view class="identity-meta">子类别：{{ item.sub_category || '-' }}<text wx:if="{{ item.product_code }}"> ｜ 测试料代码：{{ item.product_code }}</text></view>
        <view wx:if="{{ item.match_reason }}" class="identity-match-reason">{{ item.match_reason }}</view>
      </view>
      <van-button size="mini" plain bind:click="onToggleStatus" data-index="{{ index }}">
        {{ item.status === 'disabled' ? '启用' : '停用' }}
      </van-button>
    </view>
    <view wx:if="{{ loading }}" class="identity-list__footer">继续加载型号...</view>
    <view wx:elif="{{ isEnd }}" class="identity-list__footer">已显示全部 {{ total }} 个型号</view>
  </view>

  <van-toast id="van-toast" />
</view>
