.identity-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f7f8fa;
}

.identity-header {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.identity-title {
  color: #111827;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.identity-hint {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.identity-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.identity-action {
  min-width: 0;
}

.identity-actions--single {
  grid-template-columns: minmax(160rpx, 260rpx);
  justify-content: end;
}

.identity-form__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.identity-loading {
  min-height: calc(100vh - 360rpx);
  box-sizing: border-box;
  padding: 48rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.identity-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.identity-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.identity-card--disabled {
  opacity: 0.68;
}

.identity-card__main {
  min-width: 0;
  flex: 1;
}

.identity-card__top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.identity-code {
  color: #2563eb;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.identity-model {
  margin-top: 10rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
  word-break: break-all;
}

.identity-meta {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}

.identity-supplier {
  margin-top: 6rpx;
  color: #475569;
  font-size: 24rpx;
}

.identity-match-reason {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #eef6ff;
  color: #1d4ed8;
  font-size: 22rpx;
}
