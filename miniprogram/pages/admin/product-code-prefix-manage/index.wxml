<view class="zone-page">
  <view class="zone-header">
    <view class="zone-toolbar__hint">
      产品代码前缀用于组成完整产品代码。停用只影响新建物料和新入库，历史数据仍按原完整代码追溯。
    </view>
    <view wx:if="{{ !loading && !loadError }}" class="project-count">共 {{ prefixes.length }} 个前缀</view>
    <van-button type="primary" round block bind:click="onCreatePrefix">新建前缀</van-button>
  </view>

  <view class="zone-hint">
    前缀本身是物料身份的一部分，已创建后不支持修改；完整产品代码由系统自动组合，例如 J + 001 = J-001。
  </view>

  <view wx:if="{{ loading }}" class="zone-loading">
    <van-loading type="spinner" vertical>加载中...</van-loading>
  </view>

  <view wx:elif="{{ loadError }}" class="project-state">
    <view class="project-state__title">加载产品代码前缀失败</view>
    <view class="project-state__text">{{ loadError }}</view>
    <van-button size="small" type="primary" plain round bind:click="onReloadPrefixes">重新加载</van-button>
  </view>

  <view wx:elif="{{ prefixes.length === 0 }}" class="project-state">
    <view class="project-state__title">暂无产品代码前缀</view>
    <view class="project-state__text">请确认云函数已部署，系统会自动初始化 J、S、Y、M。</view>
    <van-button size="small" type="primary" plain round bind:click="onReloadPrefixes">重新加载</van-button>
  </view>

  <view wx:else class="zone-list">
    <block wx:for="{{ prefixes }}" wx:key="prefix">
      <view class="zone-card {{ item.status === 'disabled' ? 'zone-card--disabled' : '' }}">
        <view class="zone-card__main">
          <view class="project-code">{{ item.prefix }}</view>
          <view class="zone-card__meta">
            <van-tag plain type="primary" wx:if="{{ item.category === 'chemical' }}">化材</van-tag>
            <van-tag plain type="success" wx:else>膜材</van-tag>
            <van-tag plain color="#2563eb" wx:if="{{ item.is_builtin }}">默认</van-tag>
            <van-tag plain color="#6b7280" wx:if="{{ item.status === 'disabled' }}">已停用</van-tag>
          </view>
        </view>
        <view class="zone-card__actions">
          <van-button size="mini" plain bind:click="onTogglePrefix" data-index="{{ index }}">
            {{ item.status === 'disabled' ? '启用' : '停用' }}
          </van-button>
          <van-button size="mini" plain bind:click="onMoveUp" data-index="{{ index }}" disabled="{{ index === 0 }}">上移</van-button>
          <van-button size="mini" plain bind:click="onMoveDown" data-index="{{ index }}" disabled="{{ index === prefixes.length - 1 }}">下移</van-button>
        </view>
      </view>
    </block>
  </view>

  <van-popup
    show="{{ formVisible }}"
    position="bottom"
    round
    closeable
    bind:close="onCloseForm"
  >
    <view class="project-form-panel">
      <view class="project-form-panel__title">
        新建产品代码前缀
      </view>
      <view class="project-form-panel__hint">
        前缀填写 1-4 位大写英文字母。系统会在完整产品代码中自动加入横杠。
      </view>

      <van-field
        label="前缀"
        value="{{ form.prefix }}"
        placeholder="JP"
        required
        maxlength="4"
        input-align="left"
        bind:input="onPrefixInput"
        bind:change="onPrefixInput"
      />
      <view class="project-form-panel__example">示例：J、JP、LAB</view>

      <view class="prefix-category">
        <van-button
          size="small"
          round
          type="{{ form.category === 'chemical' ? 'primary' : 'default' }}"
          bind:click="onSelectChemical"
        >化材</van-button>
        <van-button
          size="small"
          round
          type="{{ form.category === 'film' ? 'primary' : 'default' }}"
          bind:click="onSelectFilm"
        >膜材</van-button>
      </view>

      <view class="project-form-panel__actions">
        <van-button plain round block bind:click="onCloseForm" disabled="{{ formSubmitting }}">取消</van-button>
        <van-button type="primary" round block loading="{{ formSubmitting }}" bind:click="onSubmitForm">
          创建前缀
        </van-button>
      </view>
    </view>
  </van-popup>
</view>
