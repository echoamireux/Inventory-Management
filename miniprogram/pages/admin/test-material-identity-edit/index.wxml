<view class="identity-edit-page">
  <view class="edit-header">
    <view class="edit-hint">这里维护测试料的真实物料名称、子类别和原厂型号；J-999 / M-999 这类产品代码只作为测试料代码壳。</view>
  </view>

  <view wx:if="{{ loading }}" class="loading-state">
    <van-loading type="spinner" vertical>加载测试料主数据...</van-loading>
  </view>

  <view wx:elif="{{ materialOptions.length === 0 }}" class="empty-card">
    <van-empty description="暂无已启用测试料主数据">
      <view class="empty-tip">请先新增并启用测试料代码壳，再回来维护具体测试料。</view>
      <view class="empty-actions" wx:if="{{ canManageSubcategories }}">
        <van-button round type="primary" size="small" bind:click="onManageMaterialMaster">去维护测试料主数据</van-button>
      </view>
    </van-empty>
  </view>

  <block wx:else>
    <view class="form-section">
      <view class="section-title">基础信息</view>
      <van-cell-group inset>
        <van-cell
          title="测试料产品代码"
          required
          is-link
          value="{{ form.product_code || '请选择' }}"
          bind:click="onShowMaterialPicker"
        />
        <view wx:if="{{ selectedMaterial }}" class="selected-material-summary">
          所属代码壳：{{ selectedMaterial.product_code }}｜{{ selectedMaterial.category === 'film' ? '膜材' : '化材' }}
        </view>

        <van-field
          label="物料名称"
          value="{{ form.material_name }}"
          placeholder="例如 环氧树脂样品"
          required
          clearable
          error-message="{{ materialNameError }}"
          bind:change="onMaterialNameInput"
        />
        <view class="field-guide field-guide--inside">
          用于标签、入库、库存查询和导出的“物料名称”列。
        </view>

        <van-cell
          title="子类别"
          required
          is-link
          value="{{ form.sub_category || '请选择' }}"
          bind:click="onShowSubCategoryPicker"
        />
        <view class="subcategory-manage-entry" wx:if="{{ form.category && canManageSubcategories }}">
          <text class="subcategory-manage-link" bindtap="onManageSubcategories">管理子类别</text>
        </view>
        <view wx:if="{{ hasInvalidSubcategory }}" class="identity-warning">
          当前子类别已不在现行词表中，请重新选择有效子类别后再保存。
        </view>

        <van-field
          label="原厂型号"
          value="{{ form.supplier_model }}"
          placeholder="例如 TEST-CHEM-01"
          required
          clearable
          error-message="{{ supplierModelError }}"
          bind:change="onSupplierModelInput"
        />

        <van-field
          label="供应商"
          value="{{ form.supplier }}"
          placeholder="选填；作为入库和预打印默认供应商"
          clearable
          bind:change="onSupplierInput"
        />
      </van-cell-group>
      <view class="field-guide">
        供应商不会参与重复判断。同一测试料产品代码下，相同原厂型号只能维护一条，避免库存身份被拆散。
      </view>
    </view>
  </block>

  <view class="submit-btn-container" wx:if="{{ !loading && materialOptions.length > 0 }}">
    <van-button
      type="primary"
      block
      round
      size="large"
      loading="{{ submitting }}"
      disabled="{{ submitting }}"
      bind:click="onSubmit"
    >
      {{ isEdit ? '保存测试料型号' : '创建测试料型号' }}
    </van-button>
  </view>

  <van-popup show="{{ showMaterialPicker }}" position="bottom" round bind:close="onMaterialPickerCancel">
    <van-picker
      columns="{{ materialOptionLabels }}"
      default-index="{{ materialIndex || 0 }}"
      show-toolbar
      bind:confirm="onMaterialPickerConfirm"
      bind:cancel="onMaterialPickerCancel"
    />
  </van-popup>

  <van-popup show="{{ showSubCategoryPicker }}" position="bottom" round bind:close="onSubCategoryCancel">
    <van-picker
      columns="{{ subCategoryOptions }}"
      default-index="{{ subCategoryIndex || 0 }}"
      show-toolbar
      bind:confirm="onSubCategoryConfirm"
      bind:cancel="onSubCategoryCancel"
    />
  </van-popup>

  <van-toast id="van-toast" />
  <van-dialog id="van-dialog" />
</view>
