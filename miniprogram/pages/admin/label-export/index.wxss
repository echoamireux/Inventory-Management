@import "../../../app.wxss";

.container {
  min-height: 100vh;
  padding: 16px;
  padding-bottom: 112px;
  background: var(--color-bg-page);
  box-sizing: border-box;
}

.sticky-panel {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--color-bg-page);
  padding-bottom: 12px;
}

.mode-tabs {
  margin-bottom: 12px;
  overflow: hidden;
  border-radius: 12px;
  box-shadow: var(--shadow-sm);
}

.template-panel {
  background: #fff;
  border-radius: 12px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 12px;
  overflow: hidden;
}

.template-panel__title {
  padding: 14px 16px 6px;
  font-size: 14px;
  font-weight: 600;
  color: var(--color-text-primary);
}

.template-fields-preview {
  margin: 4px 14px 14px;
  padding: 10px 12px;
  background: #F8FAFC;
  border: 1px solid rgba(226, 232, 240, 0.9);
  border-radius: 10px;
}

.template-fields-preview__label {
  margin-bottom: 5px;
  font-size: 12px;
  font-weight: 600;
  color: var(--color-text-primary);
}

.template-fields-preview__text {
  font-size: 12px;
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.selection-brief {
  padding: 0 6px;
  font-size: 12px;
  color: var(--color-text-secondary);
}

.selection-tip {
  padding: 6px 6px 0;
  font-size: 12px;
  color: var(--color-text-secondary);
}

.preprint-panel,
.preprint-result,
.recent-preprint-panel {
  background: #fff;
  border: 1px solid rgba(226, 232, 240, 0.9);
  border-radius: 12px;
  box-shadow: var(--shadow-sm);
  padding: 14px;
  margin-bottom: 12px;
}

.field-label {
  padding: 8px 2px 6px;
  font-size: 13px;
  font-weight: 600;
  color: var(--color-text-primary);
}

.field-required {
  margin-left: 4px;
  color: #ee0a24;
  font-weight: 700;
}

.suggestion-list {
  margin: 8px 0 10px;
  border: 1px solid rgba(226, 232, 240, 0.9);
  border-radius: 10px;
  overflow: hidden;
}

.material-search-state {
  margin: 8px 0 10px;
  padding: 9px 12px;
  background: #F8FAFC;
  border: 1px solid rgba(226, 232, 240, 0.9);
  border-radius: 10px;
  font-size: 12px;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.material-search-state.is-error {
  background: #FFF1F2;
  border-color: rgba(244, 63, 94, 0.18);
  color: #BE123C;
}

.suggestion-row {
  padding: 10px 12px;
  border-bottom: 1px solid rgba(226, 232, 240, 0.9);
}

.suggestion-row:last-child {
  border-bottom: 0;
}

.suggestion-row__title,
.selected-material__title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 600;
  color: var(--color-text-primary);
}

.suggestion-row__meta,
.selected-material__meta {
  margin-top: 5px;
  display: flex;
  gap: 10px;
  font-size: 12px;
  color: var(--color-text-secondary);
}

.selected-material {
  margin: 10px 0 12px;
  padding: 12px;
  background: #F8FAFC;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 10px;
}

.code-text {
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--color-brand);
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
}

.form-section-title {
  margin-top: 14px;
  padding: 0 2px;
  font-size: 13px;
  font-weight: 700;
  color: var(--color-text-primary);
}

.optional-grid {
  margin-top: 2px;
}

.form-item {
  min-width: 0;
}

.print-hint {
  margin-top: 12px;
  padding: 10px 12px;
  background: #F8FAFC;
  border-radius: 10px;
  font-size: 12px;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.preprint-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
  margin-top: 14px;
}

.action-button {
  height: 42px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 600;
}

.action-button.primary {
  background: var(--color-brand);
  color: #fff;
}

.action-button.secondary {
  background: #EEF4FF;
  color: var(--color-brand);
}

.action-button.danger {
  background: #FFF1F2;
  color: #BE123C;
}

.action-button.is-disabled {
  opacity: 0.55;
}

.void-link {
  margin-top: 12px;
  min-height: 36px;
  border-top: 1px solid rgba(226, 232, 240, 0.9);
  padding-top: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
  color: #BE123C;
}

.void-link.is-disabled {
  opacity: 0.55;
}

.section-title {
  margin-bottom: 10px;
  font-size: 14px;
  font-weight: 700;
  color: var(--color-text-primary);
}

.generated-code-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(226, 232, 240, 0.9);
  font-size: 13px;
  color: var(--color-text-secondary);
}

.generated-code-row:last-child {
  border-bottom: 0;
}

.preprint-result .action-button {
  margin-top: 12px;
}

.recent-preprint-card {
  padding: 12px;
  margin-bottom: 10px;
  background: #F8FAFC;
  border: 1px solid rgba(226, 232, 240, 0.9);
  border-radius: 10px;
}

.recent-preprint-card:last-child {
  margin-bottom: 0;
}

.recent-preprint-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.recent-preprint-card__code {
  font-family: var(--font-mono);
  font-size: 14px;
  font-weight: 700;
  color: var(--color-brand);
}

.recent-preprint-card__name {
  margin-top: 4px;
  font-size: 13px;
  font-weight: 600;
  line-height: 1.45;
  color: var(--color-text-primary);
}

.recent-preprint-card__count {
  flex-shrink: 0;
  padding: 3px 8px;
  border-radius: 999px;
  background: #E0EAFF;
  font-size: 12px;
  font-weight: 700;
  color: var(--color-brand);
}

.recent-preprint-card__meta {
  margin-top: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px 10px;
  font-size: 12px;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.recent-preprint-actions {
  margin-top: 10px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.recent-preprint-action {
  min-height: 34px;
  padding: 0 6px;
  border-radius: 8px;
  background: #fff;
  border: 1px solid rgba(203, 213, 225, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 12px;
  font-weight: 600;
  color: var(--color-text-primary);
}

.recent-preprint-action.is-danger {
  border-color: rgba(244, 63, 94, 0.22);
  color: #BE123C;
  background: #FFF7F8;
}

.reprint-search {
  top: 98px;
}

.inline-refresh-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 24rpx;
}

.label-export-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 16px;
  margin-bottom: 12px;
  background: #fff;
  border: 1px solid rgba(226, 232, 240, 0.9);
  border-radius: 16px;
  box-shadow: var(--shadow-sm);
}

.label-export-row.is-selected {
  border-color: rgba(44, 104, 255, 0.32);
  box-shadow: 0 8px 18px rgba(44, 104, 255, 0.08);
}

.label-export-row__selector {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  margin-top: 2px;
  border-radius: 50%;
  border: 1.5px solid #CBD5E1;
  color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
  box-sizing: border-box;
}

.label-export-row__selector.is-selected {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: #fff;
}

.label-export-row__content {
  flex: 1;
  min-width: 0;
}

.label-export-row__title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
}

.label-export-row__code {
  font-family: var(--font-mono);
  font-size: 16px;
  font-weight: 700;
  color: var(--color-brand);
}

.label-export-row__product {
  font-family: var(--font-mono);
  font-size: 14px;
  font-weight: 600;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.label-export-row__name {
  margin-top: 6px;
  font-size: 14px;
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 1.45;
}

.label-export-row__meta {
  margin-top: 6px;
  font-size: 12px;
  color: var(--color-text-secondary);
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(8px);
  box-shadow: 0 -6px 18px rgba(15, 23, 42, 0.06);
  padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
}

.footer-bar__hint {
  margin-bottom: 10px;
  font-size: 12px;
  color: var(--color-text-secondary);
}

.footer-bar__button {
  height: 44px;
  border-radius: 999px;
  background: var(--color-brand);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-bar__button.is-disabled {
  background: #C8D2E6;
  color: rgba(255, 255, 255, 0.92);
}
