<view class="container label-export-page">
  <view class="sticky-panel">
    <van-tabs
      active="{{ mode }}"
      bind:change="onModeChange"
      color="#2C68FF"
      line-width="56px"
      border="{{ false }}"
      custom-class="mode-tabs"
    >
      <van-tab title="预生成打印标签" name="preprint"></van-tab>
      <van-tab title="补打已入库标签" name="reprint"></van-tab>
    </van-tabs>

    <view class="template-panel">
      <view class="template-panel__title">选择打印模板</view>
      <van-tabs
        active="{{ templateType }}"
        bind:change="onTemplateChange"
        color="#2C68FF"
        line-width="48px"
        border="{{ false }}"
      >
        <van-tab title="膜材信息标签" name="film"></van-tab>
        <van-tab title="化材标准瓶信息标签" name="chemical_std"></van-tab>
        <van-tab title="化材小瓶信息标签" name="chemical_mini"></van-tab>
      </van-tabs>
      <view class="template-fields-preview">
        <view class="template-fields-preview__label">本模板将打印字段</view>
        <view wx:if="{{ templateType === 'film' }}" class="template-fields-preview__text">
          标签编号、二维码内容、产品代码、物料名称、子类别、原厂型号、厚度、幅宽
        </view>
        <view wx:elif="{{ templateType === 'chemical_std' }}" class="template-fields-preview__text">
          标签编号、二维码内容、产品代码、物料名称、原厂型号
        </view>
        <view wx:else class="template-fields-preview__text">
          标签编号、二维码内容、产品代码、原厂型号
        </view>
      </view>
    </view>
  </view>

  <block wx:if="{{ mode === 'preprint' }}">
    <view class="preprint-panel">
      <view class="field-label">选择物料</view>
      <van-search
        value="{{ preprintForm.materialSearchVal }}"
        placeholder="产品代码/物料名称/原厂型号"
        shape="round"
        bind:change="onMaterialSearchChange"
        bind:clear="onMaterialSearchClear"
        custom-class="search-compact"
      />

      <view wx:if="{{ materialSearchState === 'loading' }}" class="material-search-state">
        <van-loading size="16px">正在查询物料...</van-loading>
      </view>
      <view wx:elif="{{ materialSearchState === 'empty' }}" class="material-search-state">
        未找到匹配物料，请确认产品代码/物料名称/原厂型号，或先维护物料主数据
      </view>
      <view wx:elif="{{ materialSearchState === 'error' }}" class="material-search-state is-error">
        查询物料失败，请稍后重试
      </view>

      <view wx:if="{{ materialSuggestions.length > 0 }}" class="suggestion-list">
        <view
          wx:for="{{ materialSuggestions }}"
          wx:key="_id"
          class="suggestion-row"
          bindtap="onSelectMaterial"
          data-item="{{ item }}"
        >
          <view class="suggestion-row__title">
            <text class="code-text">{{ item.display_code }}</text>
            <text>{{ item.display_name }}</text>
          </view>
          <view class="suggestion-row__meta">
            <text wx:if="{{ item.is_test_material }}">测试料</text>
            <text wx:if="{{ item.display_model }}">原厂型号 {{ item.display_model }}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{ preprintForm.selectedMaterial }}" class="selected-material">
        <view class="selected-material__title">
          <text class="code-text">{{ preprintForm.selectedMaterial.display_code }}</text>
          <text>{{ preprintForm.selectedMaterial.display_name }}</text>
        </view>
        <view class="selected-material__meta">
          {{ preprintForm.selectedMaterial.is_test_material ? '测试料：原厂型号会打印在标签上' : '正式料：有原厂型号则打印，没有则留空' }}
        </view>
      </view>

      <view class="form-section-title">打印设置</view>
      <view class="form-grid">
        <view class="form-item">
          <view class="field-label">本次生成数量</view>
          <van-field
            value="{{ preprintForm.count }}"
            type="number"
            placeholder="请输入数量"
            bind:change="onPreprintCountChange"
          />
        </view>
        <view class="form-item">
          <view class="field-label">
            原厂型号
            <text wx:if="{{ preprintForm.selectedMaterial && preprintForm.selectedMaterial.is_test_material }}" class="field-required">*</text>
          </view>
          <van-field
            value="{{ preprintForm.supplier_model }}"
            placeholder="{{ preprintForm.selectedMaterial && preprintForm.selectedMaterial.is_test_material ? '测试料必填' : '选填' }}"
            data-field="supplier_model"
            bind:change="onPreprintFieldChange"
          />
        </view>
      </view>

      <view class="form-section-title">可选补充信息</view>
      <view class="form-grid optional-grid">
        <view class="form-item">
          <view class="field-label">供应商</view>
          <van-field
            value="{{ preprintForm.supplier }}"
            placeholder="选填"
            data-field="supplier"
            bind:change="onPreprintFieldChange"
          />
        </view>
        <view class="form-item">
          <view class="field-label">样品说明</view>
          <van-field
            value="{{ preprintForm.sample_note }}"
            placeholder="选填，测试料可写送样说明"
            data-field="sample_note"
            bind:change="onPreprintFieldChange"
          />
        </view>
      </view>

      <view class="print-hint">
        点击后会生成标签编号并立即导出 Excel。二维码内容默认等于标签编号；生产批号/批次、库位、数量和过期日期在扫码入库或批量入库时填写。
      </view>

      <view class="preprint-actions">
        <view
          class="action-button primary {{ creatingPreprint ? 'is-disabled' : '' }}"
          bindtap="onCreatePreprintJob"
        >
          <van-loading wx:if="{{ creatingPreprint }}" color="#FFFFFF" size="18px" />
          <text wx:else>生成并导出标签 Excel</text>
        </view>
      </view>
    </view>

    <view wx:if="{{ preprintForm.lastRecords.length > 0 }}" class="preprint-result">
      <view class="section-title">本批已生成 {{ preprintForm.lastRecords.length }} 个标签</view>
      <view
        wx:for="{{ preprintForm.lastRecords }}"
        wx:key="_id"
        class="generated-code-row"
      >
        <text class="code-text">{{ item.unique_code }}</text>
        <text>二维码内容：{{ item.qr_content }} {{ item.status === 'voided' ? '已作废' : '' }}</text>
      </view>
      <view
        class="action-button secondary {{ exportingPreprint || !preprintForm.lastJobId ? 'is-disabled' : '' }}"
        bindtap="onExportPreprintJob"
      >
        <van-loading wx:if="{{ exportingPreprint }}" size="18px" />
        <text wx:else>重新导出本批 Excel</text>
      </view>
      <view
        class="void-link {{ voidingPreprint ? 'is-disabled' : '' }}"
        bindtap="onVoidPreprintLabels"
      >
        <van-loading wx:if="{{ voidingPreprint }}" size="16px" />
        <text wx:else>作废未入库标签</text>
      </view>
    </view>

    <view class="recent-preprint-panel">
      <view class="section-title">最近打印批次</view>
      <view wx:if="{{ loadingRecentPreprints }}" class="material-search-state">
        <van-loading size="16px">正在加载最近批次...</van-loading>
      </view>
      <view wx:elif="{{ recentPreprintJobs.length === 0 }}" class="material-search-state">
        暂无最近批次。生成并导出后，可在这里重新导出或恢复查看。
      </view>
      <block wx:else>
        <view
          wx:for="{{ recentPreprintJobs }}"
          wx:key="job_id"
          class="recent-preprint-card"
        >
          <view class="recent-preprint-card__head">
            <view>
              <view class="recent-preprint-card__code">{{ item.product_code }}</view>
              <view class="recent-preprint-card__name">{{ item.material_name }}</view>
            </view>
            <view class="recent-preprint-card__count">{{ item.count }} 个</view>
          </view>
          <view class="recent-preprint-card__meta">
            <text>{{ item.template_type === 'film' ? '膜材标签' : (item.template_type === 'chemical_std' ? '化材标准瓶' : '化材小瓶') }}</text>
            <text wx:if="{{ item.supplier_model }}">原厂型号 {{ item.supplier_model }}</text>
            <text>{{ item.start_code }}{{ item.end_code && item.end_code !== item.start_code ? (' - ' + item.end_code) : '' }}</text>
            <text>未入库 {{ item.unused_count }} / 已入库 {{ item.used_count }}</text>
          </view>
          <view class="recent-preprint-actions">
            <view class="recent-preprint-action" bindtap="onRestorePreprintJob" data-item="{{ item }}">恢复查看</view>
            <view class="recent-preprint-action" bindtap="onExportRecentPreprintJob" data-item="{{ item }}">重新导出 Excel</view>
            <view class="recent-preprint-action is-danger" bindtap="onVoidRecentPreprintJob" data-item="{{ item }}">作废未入库标签</view>
          </view>
        </view>
      </block>
    </view>
  </block>

  <block wx:else>
    <view class="sticky-panel reprint-search">
      <van-search
        value="{{ searchVal }}"
        placeholder="标签编号/产品代码/物料名称/批号"
        shape="round"
        bind:search="onSearch"
        bind:change="onSearchChange"
        bind:clear="onSearchClear"
        custom-class="search-compact"
      />

      <view class="selection-brief">
        <text>已勾选 {{ selectedIds.length }} 个标签</text>
      </view>
      <view class="selection-tip">
        请按标签编号对应基础二维码标签粘贴
      </view>
    </view>

    <view wx:if="{{ loading && !hasLoadedOnce }}" class="page-loading-state">
      <van-loading type="spinner" vertical>加载中...</van-loading>
    </view>

    <block wx:elif="{{ list.length > 0 }}">
      <view
        wx:for="{{ list }}"
        wx:key="_id"
        class="label-export-row {{ item._selected ? 'is-selected' : '' }}"
        bindtap="toggleSelectItem"
        data-id="{{ item._id }}"
      >
        <view class="label-export-row__selector {{ item._selected ? 'is-selected' : '' }}">
          <text wx:if="{{ item._selected }}">✓</text>
        </view>
        <view class="label-export-row__content">
          <view class="label-export-row__title">
            <text class="label-export-row__code">{{ item.unique_code }}</text>
            <text class="label-export-row__product">{{ item.product_code }}</text>
          </view>
          <view class="label-export-row__name">{{ item.material_name || '--' }}</view>
          <view class="label-export-row__meta">
            <text wx:if="{{ item.batch_number }}">批号 {{ item.batch_number }}</text>
            <text wx:else>未填写批号</text>
          </view>
        </view>
      </view>
    </block>

    <van-empty wx:elif="{{ hasLoadedOnce }}" description="暂无可打印标签" />

    <view wx:if="{{ loading && hasLoadedOnce }}" class="inline-refresh-state">
      <van-loading size="20px">刷新中...</van-loading>
    </view>
    <view wx:if="{{ isEnd && list.length > 0 }}" class="list-end-state">
      已无更多
    </view>

    <view class="footer-bar safe-area-bottom">
      <view class="footer-bar__hint">
        {{ selectedIds.length > 0 ? ('已勾选 ' + selectedIds.length + ' 个标签') : '请先勾选需要打印的标签' }}
      </view>
      <view
        class="footer-bar__button {{ exporting || selectedIds.length === 0 ? 'is-disabled' : '' }}"
        bindtap="onExportSelected"
      >
        <van-loading wx:if="{{ exporting }}" color="#FFFFFF" size="18px" />
        <text wx:else>导出补打标签 Excel</text>
      </view>
    </view>
  </block>
</view>

<van-toast id="van-toast" />
