<view class="container label-export-page">
  <view class="sticky-panel">
    <van-tabs
      active="{{ mode }}"
      bind:change="onModeChange"
      color="#2C68FF"
      line-width="56px"
      border="{{ false }}"
      custom-class="mode-tabs"
    >
      <van-tab title="预生成打印标签" name="preprint"></van-tab>
      <van-tab title="补打已入库标签" name="reprint"></van-tab>
    </van-tabs>

    <view class="template-panel">
      <view class="template-panel__title">选择打印模板</view>
      <van-tabs
        active="{{ templateType }}"
        bind:change="onTemplateChange"
        color="#2C68FF"
        line-width="48px"
        border="{{ false }}"
      >
        <van-tab title="化材标签" name="chemical"></van-tab>
        <van-tab title="膜材信息标签" name="film"></van-tab>
      </van-tabs>
      <view class="template-fields-preview">
        <view class="template-fields-preview__label">本模板将打印字段</view>
        <view wx:if="{{ templateType === 'film' }}" class="template-fields-preview__text">
          标签编号、二维码内容、产品代码、物料名称、子类别、原厂型号、厚度、幅宽
        </view>
        <view wx:else class="template-fields-preview__text">
          标签编号、二维码内容、产品代码、物料名称、原厂型号
        </view>
      </view>
    </view>
  </view>

  <block wx:if="{{ mode === 'preprint' }}">
    <view class="preprint-panel">
      <view class="field-label">选择产品代码</view>
      <view class="label-product-code-row">
        <view
          wx:if="{{ showPreprintCodePrefixSelector }}"
          class="label-product-code-prefix"
          bindtap="showPreprintCodePrefixSheet"
        >
          {{ preprintCodePrefix }}
          <van-icon name="arrow-down" size="12px" />
        </view>
        <view wx:else class="label-product-code-prefix is-locked">
          {{ preprintCodePrefix }}
        </view>
        <input
          class="label-product-code-input"
          value="{{ preprintForm.productCodeNumber }}"
          placeholder="请输入1-3位数字编号"
          type="number"
          maxlength="3"
          confirm-type="done"
          bindinput="onPreprintProductCodeInput"
          bindblur="onPreprintProductCodeBlur"
          bindconfirm="onPreprintProductCodeConfirm"
        />
      </view>

      <view wx:if="{{ materialSearchState === 'loading' }}" class="material-search-state">
        <van-loading size="16px">正在查询物料...</van-loading>
      </view>
      <view wx:elif="{{ materialSearchState === 'empty' }}" class="material-search-state">
        未找到 {{ preprintCodePrefix }}-{{ preprintForm.productCodeNumber }} 对应的在用物料，请先维护物料主数据
      </view>
      <view wx:elif="{{ materialSearchState === 'error' }}" class="material-search-state is-error">
        查询物料失败，请稍后重试
      </view>

      <view wx:if="{{ preprintForm.selectedMaterial }}" class="selected-material">
        <view class="selected-material__title">
          <text class="code-text">{{ preprintForm.selectedMaterial.display_code }}</text>
          <text>{{ preprintForm.selectedMaterial.is_test_material && preprintForm.material_name ? preprintForm.material_name : preprintForm.selectedMaterial.display_name }}</text>
        </view>
        <view class="selected-material__meta">
          {{ preprintForm.selectedMaterial.is_test_material && preprintForm.sub_category ? preprintForm.sub_category : (preprintForm.selectedMaterial.is_test_material ? '测试料：请从型号库选择原厂型号' : '正式料：原厂型号由物料主数据决定') }}
        </view>
      </view>

      <view wx:if="{{ !preprintForm.selectedMaterial }}" class="preprint-selection-empty">
        <view class="preprint-selection-empty__title">请先输入产品代码</view>
        <view class="preprint-selection-empty__desc">
          选择前缀并输入 1-3 位数字编号后，系统会精确匹配在用物料；测试料原厂型号必须从已维护型号库中选择。
        </view>
      </view>

      <block wx:if="{{ preprintForm.selectedMaterial }}">
        <view class="form-section-title">打印设置</view>
        <view class="form-grid">
          <view class="form-item">
            <view class="field-label">本次生成数量</view>
            <van-field
              value="{{ preprintForm.count }}"
              type="number"
              placeholder="请输入数量"
              bind:change="onPreprintCountChange"
            />
          </view>
          <view class="form-item">
            <view class="field-label">
              原厂型号
              <text wx:if="{{ preprintForm.selectedMaterial.is_test_material }}" class="field-required">*</text>
            </view>
            <block wx:if="{{ preprintForm.selectedMaterial.is_test_material }}">
              <van-field
                value="{{ preprintForm.supplier_model }}"
                placeholder="{{ testMaterialIdentityLoading ? '型号加载中...' : '请选择已维护型号' }}"
                readonly
                right-icon="arrow"
                bind:tap="showTestMaterialIdentitySheet"
              />
              <view wx:if="{{ testMaterialIdentityNotice }}" class="field-inline-notice">
                {{ testMaterialIdentityNotice }}
              </view>
            </block>
            <block wx:else>
              <van-field
                value="{{ preprintForm.supplier_model }}"
                readonly
              />
            </block>
          </view>
          <view wx:if="{{ templateType === 'film' }}" class="form-item">
            <view class="field-label">
              厚度(μm)
              <text wx:if="{{ templateType === 'film' }}" class="field-required">*</text>
            </view>
            <van-field
              value="{{ preprintForm.thickness_um }}"
              placeholder="{{ preprintForm.filmThicknessLocked ? '由物料主数据带出' : '请输入厚度' }}"
              type="digit"
              readonly="{{ !preprintForm.selectedMaterial.is_test_material && preprintForm.filmThicknessLocked }}"
              data-field="thickness_um"
              bind:change="onPreprintFieldChange"
            />
          </view>
          <view wx:if="{{ templateType === 'film' }}" class="form-item">
            <view class="field-label">
              本批次实际幅宽(mm)
              <text wx:if="{{ templateType === 'film' }}" class="field-required">*</text>
            </view>
            <van-field
              value="{{ preprintForm.width_mm }}"
              placeholder="{{ preprintForm.filmWidthLocked ? '由物料主数据带出' : '请输入本批次实际幅宽' }}"
              type="digit"
              readonly="{{ !preprintForm.selectedMaterial.is_test_material && preprintForm.filmWidthLocked }}"
              data-field="width_mm"
              bind:change="onPreprintFieldChange"
            />
          </view>
        </view>

        <view class="form-section-title">本次内部备注</view>
        <view class="optional-info-hint">
          仅保存到本次标签快照，用于后续追溯，不打印在标签上。
        </view>
        <view class="form-grid optional-grid">
          <view class="form-item">
            <view class="field-label">本次打印备注</view>
            <van-field
              value="{{ preprintForm.sample_note }}"
              placeholder="选填"
              data-field="sample_note"
              bind:change="onPreprintFieldChange"
            />
          </view>
        </view>

        <view class="print-hint">
          点击后会生成标签编号并立即导出 Excel。二维码内容默认等于标签编号；生产批号/批次、库位、数量和过期日期在扫码入库或批量入库时填写。
        </view>

        <view class="preprint-actions">
          <view
            class="action-button primary {{ creatingPreprint ? 'is-disabled' : '' }}"
            bindtap="onCreatePreprintJob"
          >
            <van-loading wx:if="{{ creatingPreprint }}" color="#FFFFFF" size="18px" />
            <text wx:else>生成并导出标签 Excel</text>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{ preprintForm.lastRecords.length > 0 }}" class="preprint-result">
      <view class="section-title">本批已生成 {{ preprintForm.lastRecords.length }} 个标签</view>
      <view
        wx:for="{{ preprintForm.lastRecords }}"
        wx:key="_id"
        class="generated-code-row"
      >
        <text class="code-text">{{ item.unique_code }}</text>
        <text>二维码内容：{{ item.qr_content }} {{ item.status === 'voided' ? '已作废' : '' }}</text>
      </view>
      <view
        class="action-button secondary {{ exportingPreprint || !preprintForm.lastJobId ? 'is-disabled' : '' }}"
        bindtap="onExportPreprintJob"
      >
        <van-loading wx:if="{{ exportingPreprint }}" size="18px" />
        <text wx:else>重新导出本批 Excel</text>
      </view>
      <view
        class="void-link {{ voidingPreprint ? 'is-disabled' : '' }}"
        bindtap="onVoidPreprintLabels"
      >
        <van-loading wx:if="{{ voidingPreprint }}" size="16px" />
        <text wx:else>作废未入库标签</text>
      </view>
    </view>

    <view class="recent-preprint-panel">
      <view class="section-title">最近打印批次</view>
      <view wx:if="{{ loadingRecentPreprints }}" class="material-search-state">
        <van-loading size="16px">正在加载最近批次...</van-loading>
      </view>
      <view wx:elif="{{ recentPreprintJobs.length === 0 }}" class="material-search-state">
        暂无最近批次。生成并导出后，可在这里重新导出或恢复查看。
      </view>
      <block wx:else>
        <view
          wx:for="{{ recentPreprintJobs }}"
          wx:key="job_id"
          class="recent-preprint-card"
        >
          <view class="recent-preprint-card__head">
            <view>
              <view class="recent-preprint-card__code">{{ item.product_code }}</view>
              <view class="recent-preprint-card__name">{{ item.material_name }}</view>
            </view>
            <view class="recent-preprint-card__count">{{ item.count }} 个</view>
          </view>
          <view class="recent-preprint-card__meta">
            <text>{{ item.template_type === 'film' ? '膜材标签' : '化材标签' }}</text>
            <text wx:if="{{ item.supplier_model }}">原厂型号 {{ item.supplier_model }}</text>
            <text>{{ item.start_code }}{{ item.end_code && item.end_code !== item.start_code ? (' - ' + item.end_code) : '' }}</text>
            <text>未入库 {{ item.unused_count }} / 已入库 {{ item.used_count }}</text>
            <text wx:if="{{ item.status === 'creating' }}">生成未完成</text>
            <text wx:elif="{{ item.export_status === 'failed' }}">Excel 导出失败</text>
          </view>
          <view class="recent-preprint-actions">
            <view class="recent-preprint-action" bindtap="onRestorePreprintJob" data-item="{{ item }}">{{ item.status === 'creating' ? '恢复生成' : '恢复查看' }}</view>
            <view wx:if="{{ item.status === 'ready' }}" class="recent-preprint-action" bindtap="onExportRecentPreprintJob" data-item="{{ item }}">重新导出 Excel</view>
            <view wx:if="{{ item.used_count === 0 }}" class="recent-preprint-action is-danger" bindtap="onVoidRecentPreprintJob" data-item="{{ item }}">作废未入库标签</view>
          </view>
        </view>
      </block>
    </view>
  </block>

  <block wx:else>
    <view class="sticky-panel reprint-search">
      <van-search
        value="{{ searchVal }}"
        placeholder="标签编号/产品代码/物料名称/批号"
        shape="round"
        bind:search="onSearch"
        bind:change="onSearchChange"
        bind:clear="onSearchClear"
        custom-class="search-compact"
      />

      <view class="selection-brief">
        <text>已勾选 {{ selectedIds.length }} 个标签</text>
      </view>
      <view class="selection-tip">
        请按标签编号对应基础二维码标签粘贴
      </view>
    </view>

    <view wx:if="{{ loading && !hasLoadedOnce }}" class="page-loading-state">
      <van-loading type="spinner" vertical>加载中...</van-loading>
    </view>

    <block wx:elif="{{ list.length > 0 }}">
      <view
        wx:for="{{ list }}"
        wx:key="_id"
        class="label-export-row {{ item._selected ? 'is-selected' : '' }}"
        bindtap="toggleSelectItem"
        data-id="{{ item._id }}"
      >
        <view class="label-export-row__selector {{ item._selected ? 'is-selected' : '' }}">
          <text wx:if="{{ item._selected }}">✓</text>
        </view>
        <view class="label-export-row__content">
          <view class="label-export-row__title">
            <text class="label-export-row__code">{{ item.unique_code }}</text>
            <text class="label-export-row__product">{{ item.product_code }}</text>
          </view>
          <view class="label-export-row__name">{{ item.material_name || '--' }}</view>
          <view class="label-export-row__meta">
            <text wx:if="{{ item.batch_number }}">批号 {{ item.batch_number }}</text>
            <text wx:else>未填写批号</text>
          </view>
        </view>
      </view>
    </block>

    <van-empty wx:elif="{{ hasLoadedOnce }}" description="暂无可打印标签" />

    <view wx:if="{{ loading && hasLoadedOnce }}" class="inline-refresh-state">
      <van-loading size="20px">刷新中...</van-loading>
    </view>
    <view wx:if="{{ isEnd && list.length > 0 }}" class="list-end-state">
      已无更多
    </view>

    <view class="footer-bar safe-area-bottom">
      <view class="footer-bar__hint">
        {{ selectedIds.length > 0 ? ('已勾选 ' + selectedIds.length + ' 个标签') : '请先勾选需要打印的标签' }}
      </view>
      <view
        class="footer-bar__button {{ exporting || selectedIds.length === 0 ? 'is-disabled' : '' }}"
        bindtap="onExportSelected"
      >
        <van-loading wx:if="{{ exporting }}" color="#FFFFFF" size="18px" />
        <text wx:else>导出补打标签 Excel</text>
      </view>
    </view>
  </block>
</view>

<van-popup
  show="{{ showTestMaterialIdentitySheet }}"
  position="bottom"
  round
  closeable
  bind:close="onTestMaterialIdentityClose"
>
  <view class="test-identity-popup">
    <view class="test-identity-popup__title">选择测试料原厂型号</view>
    <van-search
      value="{{ testMaterialIdentitySearchVal }}"
      placeholder="搜索原厂型号/物料名称/子类别"
      shape="round"
      bind:change="onTestMaterialIdentitySearchChange"
      bind:clear="onTestMaterialIdentitySearchClear"
      custom-class="search-compact"
    />
    <view wx:if="{{ testMaterialIdentitySearchMessage }}" class="material-search-state">
      {{ testMaterialIdentitySearchMessage }}
    </view>
    <view wx:if="{{ testMaterialIdentityLoading && filteredTestMaterialIdentityActions.length === 0 }}" class="material-search-state">
      <van-loading size="16px">正在加载型号...</van-loading>
    </view>
    <view wx:elif="{{ filteredTestMaterialIdentityActions.length === 0 }}" class="material-search-state">
      {{ testMaterialIdentitySearchVal ? '没有匹配的测试料型号，请换个关键词' : '当前测试料还没有已启用型号，请联系管理员维护测试料型号库' }}
    </view>
    <scroll-view
      wx:else
      class="test-identity-list"
      scroll-y
      bindscrolltolower="onTestMaterialIdentityReachBottom"
    >
      <view
        wx:for="{{ filteredTestMaterialIdentityActions }}"
        wx:key="identity_key"
        class="test-identity-row"
        bindtap="onTestMaterialIdentitySelect"
        data-item="{{ item }}"
      >
        <view class="test-identity-row__title">{{ item.supplier_model || item.value || '-' }}</view>
        <view class="test-identity-row__meta">
          <text>{{ item.label_material_name || item.material_name || '-' }}</text>
          <text>{{ item.sub_category || item.subcategory_key || '-' }}</text>
          <text>{{ item.product_code || '-' }}</text>
        </view>
      </view>
      <view wx:if="{{ testMaterialIdentityLoading }}" class="test-identity-list__footer">继续加载型号...</view>
      <view wx:elif="{{ testMaterialIdentityIsEnd }}" class="test-identity-list__footer">
        已显示全部 {{ testMaterialIdentityTotal }} 个型号
      </view>
    </scroll-view>
  </view>
</van-popup>

<van-action-sheet
  show="{{ showPreprintCodePrefixSheet }}"
  actions="{{ preprintCodePrefixOptions }}"
  bind:close="onPreprintCodePrefixClose"
  bind:select="onPreprintCodePrefixSelect"
/>

<van-toast id="van-toast" />
