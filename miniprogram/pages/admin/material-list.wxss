/* pages/admin/material-list.wxss */

/* 容器 */
.container {
  min-height: 100vh;
  background-color: #f7f8fa;
}

.status-tabs {
  background: #ffffff;
  border-top: 1rpx solid #f1f5f9;
}

.pb-100 {
  padding-bottom: 200rpx;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}

.count-text {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #969799;
  font-weight: bold;
}

.top-btns {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
}

.top-btns--identity {
  flex: 1;
}


/* 列表容器 */
.list-wrapper {
  padding: 0 24rpx;
}

.identity-result-section {
  padding: 0 24rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 16rpx;
}

.section-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.section-count {
  color: #64748b;
  font-size: 24rpx;
}

.identity-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.identity-card--disabled {
  opacity: 0.68;
}

.identity-card__main {
  min-width: 0;
  flex: 1;
}

.identity-card__top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.identity-code {
  color: #2563eb;
  font-size: 30rpx;
  font-weight: 700;
}

.identity-model {
  display: block;
  margin-top: 8rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
  word-break: break-all;
}

.identity-meta {
  display: block;
  margin-top: 6rpx;
  color: #64748b;
  font-size: 24rpx;
}

.identity-parent {
  display: block;
  margin-top: 10rpx;
  color: #334155;
  font-size: 26rpx;
}

.match-reason {
  align-self: flex-start;
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #eef6ff;
  color: #1d4ed8;
  font-size: 22rpx;
  line-height: 1.4;
}

.section-title-row--padded {
  padding: 0 24rpx;
}

.loading-state {
  padding: 80rpx 24rpx;
}

/* 卡片 */
.card {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.card-selected {
  background: #e6f4ff;
  border: 2rpx solid #1989fa;
  box-shadow: 0 4rpx 16rpx rgba(25, 137, 250, 0.15);
}

.card-checkbox {
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 卡片内容区 */
.card-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.code {
  font-size: 32rpx;
  font-weight: bold;
  color: #1989fa;
  margin-right: 12rpx;
}

.name {
  font-size: 28rpx;
  color: #323233;
  margin-bottom: 6rpx;
}

.supplier {
  font-size: 24rpx;
  color: #969799;
}

.ml-8 {
  margin-left: 8rpx;
}

/* 操作按钮区 */
.card-actions {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 批量操作栏 */
.batch-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.batch-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.batch-text {
  margin-left: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #323233;
}

.batch-right {
  display: flex;
  flex-direction: row;
}
