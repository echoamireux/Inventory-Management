<!--pages/admin/material-list.wxml-->
<view class="container pb-100">
  <view class="search-transparent bg-white">
    <van-search
      value="{{ searchVal }}"
      placeholder="主数据：产品代码/物料名/原厂型号等"
      shape="round"
      bind:search="onSearch"
      bind:clear="onSearchClear"
      bind:change="onSearchChange"
      custom-class="search-compact"
    />
  </view>

  <van-tabs wx:if="{{ !hasSearchKeyword }}" active="{{ activeTab }}" bind:change="onTabChange" color="#1989fa" sticky>
    <van-tab title="物料主数据" name="materials"></van-tab>
    <van-tab title="测试料" name="testIdentity"></van-tab>
  </van-tabs>

  <view wx:if="{{ activeTab === 'materials' && !hasSearchKeyword }}" class="status-tabs">
    <van-tabs active="{{ materialStatus }}" bind:change="onMaterialStatusChange" color="#1989fa" line-width="28px">
      <van-tab title="在用" name="active"></van-tab>
      <van-tab title="已归档" name="archived"></van-tab>
    </van-tabs>
  </view>

  <van-notice-bar
    wx:if="{{ searchNoticeText }}"
    left-icon="info-o"
    text="{{ searchNoticeText }}"
    color="#1d4ed8"
    background="#eef6ff"
  />

  <view class="top-bar {{ activeTab === 'materials' && !hasSearchKeyword ? 'top-bar--after-status' : '' }}">
    <view class="count-wrap">
      <text wx:if="{{ hasSearchKeyword }}" class="count-text">全局搜索结果：{{ total }} 项物料 · {{ identityTotal }} 个型号</text>
      <text wx:elif="{{ activeTab === 'materials' }}" class="count-text">
        {{ total }} 种{{ materialStatus === 'archived' ? '已归档物料' : '在用物料' }}
      </text>
      <text wx:else class="count-text">{{ identityTotal }} 个测试料型号</text>
    </view>

    <view class="top-actions" wx:if="{{ !isEditMode && activeTab === 'materials' && materialStatus === 'active' && !hasSearchKeyword }}">
      <view class="top-action"><van-button block type="default" size="small" round icon="upgrade" bind:click="onImport">导入</van-button></view>
      <view class="top-action"><van-button block type="primary" size="small" round icon="plus" bind:click="onAdd">新增</van-button></view>
    </view>
    <view class="top-actions top-actions--wide-single" wx:if="{{ !isEditMode && activeTab === 'testIdentity' && !hasSearchKeyword }}">
      <view class="top-action"><van-button block type="primary" size="small" round icon="plus" bind:click="onCreateTestMaterialIdentity">新增测试料</van-button></view>
    </view>
    <view class="top-actions top-actions--single" wx:if="{{ isEditMode }}">
      <view class="top-action"><van-button block type="default" size="small" round plain bind:click="toggleEditMode">取消</van-button></view>
    </view>
  </view>

  <view wx:if="{{ hasSearchKeyword }}" class="section-title-row section-title-row--padded">
    <text class="section-title">物料主数据</text>
    <text class="section-count">{{ total }} 项</text>
  </view>

  <view class="list-wrapper" wx:if="{{ (activeTab === 'materials' || hasSearchKeyword) && list.length > 0 }}">
    <block wx:for="{{ list }}" wx:key="_id">
      <view
        class="card {{ item.checked ? 'card-selected' : '' }}"
        bind:longpress="onLongPress"
        bind:tap="onItemClick"
        data-id="{{ item._id }}"
      >
        <van-checkbox wx:if="{{ isEditMode }}" value="{{ item.checked }}" custom-class="card-checkbox" catch:tap="noop" />

        <view class="card-content">
          <view class="card-header">
            <text class="code">{{ item.product_code }}</text>
            <van-tag type="{{ item.category === 'chemical' ? 'primary' : 'success' }}" plain size="medium">
              {{ item.category === 'chemical' ? '化材' : '膜材' }}
            </van-tag>
            <van-tag wx:if="{{ item.status === 'archived' }}" type="warning" plain size="medium" custom-class="ml-8">已归档</van-tag>
            <van-tag wx:elif="{{ hasSearchKeyword }}" type="success" plain size="medium" custom-class="ml-8">在用</van-tag>
          </view>
          <text class="name">{{ item.material_name }}</text>
          <text class="supplier" wx:if="{{ item.supplier }}">{{ item.supplier }}</text>
          <text class="match-reason" wx:if="{{ hasSearchKeyword && item.match_reason }}">{{ item.match_reason }}</text>
        </view>

        <view class="card-actions" wx:if="{{ !isEditMode && activeTab === 'materials' && materialStatus === 'active' && !hasSearchKeyword }}">
          <text class="card-action card-action--archive" catch:tap="onArchive" data-id="{{ item._id }}">归档</text>
        </view>
      </view>
    </block>
  </view>

  <view
    wx:if="{{ (activeTab === 'testIdentity' || hasSearchKeyword) && identityList.length > 0 }}"
    class="identity-result-section"
  >
    <view wx:if="{{ hasSearchKeyword }}" class="section-title-row">
      <text class="section-title">测试料型号</text>
      <text class="section-count">{{ identityTotal }} 个</text>
    </view>
    <view
      wx:for="{{ identityList }}"
      wx:key="identity_key"
      class="identity-card {{ item.status === 'disabled' ? 'identity-card--disabled' : '' }}"
      bind:tap="onIdentityItemClick"
      data-id="{{ item._id }}"
    >
      <view class="identity-card__main">
        <view class="identity-card__top">
          <text class="identity-model-title">{{ item.supplier_model || '-' }}</text>
          <view class="identity-card__tags">
            <van-tag type="{{ item.category === 'film' ? 'success' : 'primary' }}" plain>
              {{ item.category === 'film' ? '膜材' : '化材' }}
            </van-tag>
            <van-tag wx:if="{{ item.status === 'disabled' }}" plain color="#6b7280">已停用</van-tag>
            <van-tag wx:else type="success" plain>已启用</van-tag>
          </view>
        </view>
        <text class="identity-name">{{ item.label_material_name || item.material_name || '--' }}</text>
        <text class="identity-meta">子类别：{{ item.sub_category || '-' }}<text wx:if="{{ item.product_code }}"> ｜ 测试料代码：{{ item.product_code }}</text></text>
        <text class="match-reason" wx:if="{{ hasSearchKeyword && item.match_reason }}">{{ item.match_reason }}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{ (loading || identityLoading) && ((hasSearchKeyword && list.length === 0 && identityList.length === 0) || (!hasSearchKeyword && activeTab === 'materials' && list.length === 0) || (!hasSearchKeyword && activeTab === 'testIdentity' && identityList.length === 0)) }}" class="loading-state">
    <van-loading type="spinner" vertical>加载中...</van-loading>
  </view>

  <van-empty
    wx:if="{{ hasSearchKeyword && !loading && !identityLoading && list.length === 0 && identityList.length === 0 }}"
    description="未找到匹配的物料或测试料型号"
  />
  <van-empty
    wx:if="{{ !hasSearchKeyword && !loading && activeTab === 'materials' && list.length === 0 }}"
    description="{{ materialStatus === 'archived' ? '暂无已归档物料' : '暂无在用物料' }}"
  />
  <van-empty
    wx:if="{{ !hasSearchKeyword && !identityLoading && activeTab === 'testIdentity' && identityList.length === 0 }}"
    description="暂无测试料型号"
  />

  <view class="list-end-state" wx:if="{{ !hasSearchKeyword && activeTab === 'materials' && isEnd && list.length > 0 }}">已无更多</view>
  <view class="list-end-state" wx:if="{{ !hasSearchKeyword && activeTab === 'testIdentity' && identityIsEnd && identityList.length > 0 }}">已无更多型号</view>

  <view class="batch-bar" wx:if="{{ isEditMode && activeTab === 'materials' && !hasSearchKeyword }}">
    <view class="batch-left" bindtap="onSelectAll">
      <van-checkbox value="{{ isAllSelected }}" catch:tap="noop" />
      <text class="batch-text">全选</text>
    </view>
    <view class="batch-right">
      <van-button wx:if="{{ materialStatus === 'active' }}" type="danger" round bind:click="onBatchDelete">删除/归档 ({{ selectedCount }})</van-button>
      <van-button wx:else type="primary" round bind:click="onRestore">还原 ({{ selectedCount }})</van-button>
    </view>
  </view>
</view>

<van-dialog id="van-dialog" />
<van-toast id="van-toast" />
