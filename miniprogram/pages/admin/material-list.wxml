<!--pages/admin/material-list.wxml-->
<view class="container pb-100">
  <!-- 顶部状态筛选 -->
  <van-tabs active="{{ activeTab }}" bind:change="onTabChange" color="#1989fa" sticky>
    <van-tab title="活跃物料" name="active"></van-tab>
    <van-tab title="测试料型号" name="testIdentity"></van-tab>
    <van-tab title="已归档" name="archived"></van-tab>
  </van-tabs>

  <!-- 搜索栏 -->
  <view class="search-transparent bg-white">
    <van-search
        value="{{ searchVal }}"
        placeholder="产品代码/物料名称/子类别/供应商/原厂型号/包装形式/规格"
        shape="round"
        bind:search="onSearch"
        bind:clear="onSearchClear"
        bind:change="onSearchChange"
        custom-class="search-compact"
    />
  </view>

  <!-- 顶部统计与操作按钮 -->
  <view class="top-bar">
    <text wx:if="{{ activeTab !== 'testIdentity' }}" class="count-text">{{ total }} 种{{ activeTab === 'archived' ? ' (已归档)' : '' }}</text>
    <text wx:else class="count-text">{{ identityTotal }} 个型号</text>
    <view class="top-btns" wx:if="{{ !isEditMode && activeTab === 'active' }}">
      <van-button type="default" size="small" round icon="upgrade" custom-style="margin-right: 8px;" bind:click="onImport">导入</van-button>
      <van-button type="primary" size="small" round icon="plus" bind:click="onAdd">新增</van-button>
    </view>
    <view class="top-btns" wx:if="{{ !isEditMode && activeTab === 'testIdentity' }}">
      <van-button type="primary" size="small" round icon="setting-o" bind:click="onOpenTestMaterialIdentityManage">维护型号库</van-button>
    </view>
    <view class="top-btns" wx:if="{{ isEditMode }}">
      <van-button type="default" size="small" round plain bind:click="toggleEditMode">取消</van-button>
    </view>
  </view>

  <!-- 物料列表 -->
  <view class="list-wrapper" wx:if="{{ activeTab !== 'testIdentity' && list.length > 0 }}">
    <block wx:for="{{ list }}" wx:key="_id">
      <view
        class="card {{ item.checked ? 'card-selected' : '' }}"
        bind:longpress="onLongPress"
        bind:tap="onItemClick"
        data-id="{{ item._id }}"
      >
        <!-- Checkbox (编辑模式) -->
        <van-checkbox wx:if="{{ isEditMode }}" value="{{ item.checked }}" custom-class="card-checkbox" catch:tap="noop" />

        <!-- 主内容区 -->
        <view class="card-content">
          <view class="card-header">
            <text class="code">{{ item.product_code }}</text>
            <van-tag type="{{ item.category === 'chemical' ? 'primary' : 'success' }}" plain size="medium">{{ item.category === 'chemical' ? '化材' : '膜材' }}</van-tag>
            <van-tag wx:if="{{ item.status === 'archived' }}" type="warning" plain size="medium" custom-class="ml-8">归档</van-tag>
          </view>
          <text class="name">{{ item.material_name }}</text>
          <text class="supplier" wx:if="{{ item.supplier }}">{{ item.supplier }}</text>
        </view>

        <!-- 操作按钮 (非编辑模式 + 活跃Tab) -->
        <view class="card-actions" wx:if="{{ !isEditMode && activeTab === 'active' }}">
          <van-button plain type="primary" size="mini" round custom-style="margin-bottom: 8rpx;" catch:tap="onEdit" data-id="{{ item._id }}">编辑</van-button>
          <van-button plain type="danger" size="mini" round catch:tap="onArchive" data-id="{{ item._id }}">归档</van-button>
        </view>
      </view>
    </block>
  </view>

  <view
    wx:if="{{ (activeTab === 'testIdentity' && identityList.length > 0) || (activeTab === 'active' && searchVal && identityList.length > 0) }}"
    class="identity-result-section"
  >
    <view wx:if="{{ activeTab === 'active' }}" class="section-title-row">
      <text class="section-title">测试料型号匹配</text>
      <text class="section-count">{{ identityTotal }} 个</text>
    </view>
    <view
      wx:for="{{ identityList }}"
      wx:key="identity_key"
      class="identity-card {{ item.status === 'disabled' ? 'identity-card--disabled' : '' }}"
      bindtap="onOpenTestMaterialIdentityManage"
    >
      <view class="identity-card__main">
        <view class="identity-card__top">
          <text class="identity-code">{{ item.product_code }}</text>
          <van-tag type="{{ item.category === 'film' ? 'success' : 'primary' }}" plain size="medium">{{ item.category === 'film' ? '膜材' : '化材' }}</van-tag>
          <van-tag wx:if="{{ item.status === 'disabled' }}" plain color="#6b7280">已停用</van-tag>
        </view>
        <text class="identity-model">{{ item.supplier_model }}</text>
        <text class="identity-meta">{{ item.material_name || '测试料主数据' }}</text>
      </view>
      <van-icon name="arrow" color="#9ca3af" />
    </view>
  </view>

  <!-- 空状态 -->
  <van-empty
    wx:if="{{ !loading && activeTab !== 'testIdentity' && list.length === 0 && !(searchVal && identityList.length > 0) }}"
    description="{{ activeTab === 'archived' ? '暂无归档物料' : '暂无物料数据' }}"
  />
  <van-empty wx:if="{{ !identityLoading && activeTab === 'testIdentity' && identityList.length === 0 }}" description="暂无测试料型号" />

  <view class="list-end-state" wx:if="{{ isEnd && list.length > 0 }}">已无更多</view>
  <view class="list-end-state" wx:if="{{ activeTab === 'testIdentity' && identityIsEnd && identityList.length > 0 }}">已无更多型号</view>

  <!-- 底部批量操作栏 -->
  <view class="batch-bar" wx:if="{{ isEditMode && activeTab !== 'testIdentity' }}">
    <view class="batch-left" bindtap="onSelectAll">
      <van-checkbox value="{{ isAllSelected }}" catch:tap="noop" />
      <text class="batch-text">全选</text>
    </view>
    <view class="batch-right">
      <van-button wx:if="{{ activeTab === 'active' }}" type="danger" round bind:click="onBatchDelete">删除/归档 ({{ selectedCount }})</van-button>
      <van-button wx:else type="primary" round bind:click="onRestore">还原 ({{ selectedCount }})</van-button>
    </view>
  </view>
</view>

<van-dialog id="van-dialog" />
<van-toast id="van-toast" />
