<view class="zone-page">
  <view class="zone-header">
    <view class="zone-header__main">
      <view class="zone-header__copy">
        <view class="zone-toolbar__hint">默认库区、共享库区和详细坐标统一维护。</view>
      </view>
      <view class="zone-header__action">
        <van-button custom-class="zone-header-button" type="primary" plain size="small" bind:click="onCreateZone">新建库区</van-button>
      </view>
    </view>
  </view>

  <view class="zone-hint">
    改名会同步更新当前库存展示；停用后，该库区将不再出现在新表单中，历史库存记录仍保留原库区信息。
  </view>

  <view wx:if="{{ loading }}" class="zone-loading">
    <van-loading type="spinner" vertical>加载中...</van-loading>
  </view>

  <view wx:else class="zone-list">
    <block wx:for="{{ zones }}" wx:key="zone_key" wx:for-item="zone" wx:for-index="zoneIndex">
      <view class="zone-card {{ zone.status === 'disabled' ? 'zone-card--disabled' : '' }}">
        <view class="zone-card__main">
          <view class="zone-card__name">{{ zone.name }}</view>
          <view class="zone-card__meta">
            <van-tag plain type="primary" wx:if="{{ zone.is_builtin }}">默认</van-tag>
            <van-tag plain type="success" wx:else>共享</van-tag>
            <van-tag plain color="#6b7280" wx:if="{{ zone.status === 'disabled' }}">已停用</van-tag>
            <text class="zone-card__scope">{{ zone.scope === 'film' ? '膜材' : (zone.scope === 'chemical' ? '化材' : '共享') }}</text>
          </view>
        </view>
        <view class="zone-card__actions">
          <van-button size="mini" plain type="primary" bind:click="onRenameZone" data-index="{{ zoneIndex }}">改名</van-button>
          <van-button size="mini" plain bind:click="onToggleZone" data-index="{{ zoneIndex }}">
            {{ zone.status === 'disabled' ? '启用' : '停用' }}
          </van-button>
          <van-button size="mini" plain bind:click="onMoveUp" data-index="{{ zoneIndex }}" disabled="{{ zoneIndex === 0 }}">上移</van-button>
          <van-button size="mini" plain bind:click="onMoveDown" data-index="{{ zoneIndex }}" disabled="{{ zoneIndex === zones.length - 1 }}">下移</van-button>
        </view>
        <view class="zone-detail-section">
          <view class="zone-detail-header">
            <view class="zone-detail-header__main">
              <text class="zone-detail-title">详细坐标</text>
              <text class="zone-detail-hint">入库/移库必选</text>
            </view>
            <view class="zone-detail-header__action">
              <van-button custom-class="zone-detail-add-button" size="mini" plain type="primary" bind:click="onCreateDetail" data-index="{{ zoneIndex }}">新增</van-button>
            </view>
          </view>
          <view wx:if="{{ zone.details.length > 0 }}" class="zone-detail-list">
            <view
              wx:for="{{ zone.details }}"
              wx:key="detail_key"
              wx:for-item="detail"
              wx:for-index="detailIndex"
              class="zone-detail-row {{ detail.status === 'disabled' ? 'zone-detail-row--disabled' : '' }}"
            >
              <view class="zone-detail-row__content">
                <text class="zone-detail-row__name">{{ detail.name }}</text>
                <van-tag plain color="#6b7280" wx:if="{{ detail.status === 'disabled' }}">已停用</van-tag>
                <van-tag plain type="primary" wx:elif="{{ detail.is_builtin }}">默认</van-tag>
              </view>
              <view class="zone-detail-row__actions">
                <van-button custom-class="zone-detail-action-button" size="mini" plain type="primary" bind:click="onRenameDetail" data-zone-index="{{ zoneIndex }}" data-detail-index="{{ detailIndex }}">改名</van-button>
                <van-button custom-class="zone-detail-action-button" size="mini" plain bind:click="onToggleDetail" data-zone-index="{{ zoneIndex }}" data-detail-index="{{ detailIndex }}">
                  {{ detail.status === 'disabled' ? '启用' : '停用' }}
                </van-button>
                <van-button custom-class="zone-detail-action-button" size="mini" plain bind:click="onMoveDetailUp" data-zone-index="{{ zoneIndex }}" data-detail-index="{{ detailIndex }}" disabled="{{ detailIndex === 0 }}">上移</van-button>
                <van-button custom-class="zone-detail-action-button" size="mini" plain bind:click="onMoveDetailDown" data-zone-index="{{ zoneIndex }}" data-detail-index="{{ detailIndex }}" disabled="{{ detailIndex === zone.details.length - 1 }}">下移</van-button>
              </view>
            </view>
          </view>
          <view wx:else class="zone-detail-empty">未配置详细坐标，此库区表单中可自由填写详细坐标。</view>
        </view>
      </view>
    </block>
  </view>

  <van-popup
    show="{{ showCreatePopup }}"
    position="bottom"
    round
    closeable
    bind:close="onCloseCreatePopup"
  >
    <view class="zone-create-panel">
      <view class="zone-create-panel__title">新建库区</view>
      <van-field
        label="库区名称"
        value="{{ createForm.name }}"
        placeholder="请输入库区名称"
        required
        bind:change="onCreateNameChange"
      />
      <view class="zone-create-panel__section">
        <view class="zone-create-panel__label">库区类型</view>
        <van-radio-group value="{{ createForm.scope }}" bind:change="onCreateScopeChange">
          <view class="zone-scope-options">
            <van-radio
              wx:for="{{ scopeOptions }}"
              wx:key="value"
              name="{{ item.value }}"
            >
              {{ item.name }}
            </van-radio>
          </view>
        </van-radio-group>
      </view>
      <van-button type="primary" round block bind:click="onSubmitCreateZone">
        创建库区
      </van-button>
    </view>
  </van-popup>
</view>
