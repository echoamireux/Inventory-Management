.zone-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  box-sizing: border-box;
}

.zone-header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.zone-toolbar__title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
}

.zone-toolbar__hint {
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.zone-hint {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #eef4ff;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.6;
}

.zone-loading {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

.zone-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.zone-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.zone-card--disabled {
  opacity: 0.7;
}

.zone-card__main {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.zone-card__name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.zone-card__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.zone-card__scope {
  font-size: 24rpx;
  color: #64748b;
}

.zone-card__actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.zone-detail-section {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e5e7eb;
}

.zone-detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.zone-detail-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.zone-detail-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #94a3b8;
}

.zone-detail-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.zone-detail-row {
  padding: 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}

.zone-detail-row--disabled {
  opacity: 0.68;
}

.zone-detail-row__main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.zone-detail-row__name {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}

.zone-detail-row__actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.zone-detail-empty {
  padding: 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.5;
}

.zone-create-panel {
  padding: 36rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.zone-create-panel__title {
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
}

.zone-create-panel__section {
  margin: 24rpx 0 32rpx;
}

.zone-create-panel__label {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.zone-scope-options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}
