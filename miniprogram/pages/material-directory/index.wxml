<view class="container pb-50">
  <van-tabs active="{{ activeTab }}" bind:change="onTabChange" color="#1989fa" sticky>
    <van-tab title="全部" name="all"></van-tab>
    <van-tab title="化材" name="chemical"></van-tab>
    <van-tab title="膜材" name="film"></van-tab>
  </van-tabs>

  <view class="search-transparent bg-white">
    <van-search
        value="{{ searchVal }}"
        placeholder="物料目录：产品代码/物料名/原厂型号等"
        shape="round"
        bind:search="onSearch"
        bind:clear="onSearchClear"
        bind:change="onSearchChange"
        custom-class="search-compact"
    />
  </view>

  <van-notice-bar
    wx:if="{{ searchMessage }}"
    left-icon="info-o"
    text="{{ searchMessage }}"
    color="#1d4ed8"
    background="#eef6ff"
  />

  <view class="px-15 py-10 text-secondary text-sm">
    <text>共找到 {{ total }} 种物料</text>
  </view>

  <view class="list-wrapper" wx:if="{{ list.length > 0 }}">
    <block wx:for="{{ list }}" wx:key="directory_key">
      <view class="material-card" data-id="{{ item._id }}" data-kind="{{ item.directory_kind }}">
        <view class="material-card__top">
          <view class="material-card__title">{{ item.display_title || '-' }}</view>
          <view class="material-card__tags">
            <van-tag type="{{ item.category === 'chemical' ? 'primary' : 'success' }}" plain>
              {{ item.category === 'chemical' ? '化材' : '膜材' }}
            </van-tag>
            <van-tag type="success" plain>已启用</van-tag>
          </view>
        </view>
        <view class="material-card__name">{{ item.display_name || '-' }}</view>
        <view class="material-card__meta">{{ item.display_meta || '子类别：-' }}</view>
        <view class="match-reason" wx:if="{{ item.match_reason }}">{{ item.match_reason }}</view>
      </view>
    </block>
  </view>

  <van-empty
    wx:if="{{ !loading && list.length === 0 }}"
    description="{{ searchVal ? '未找到匹配的已启用物料目录' : '暂无已启用物料目录' }}"
  />
  <view class="list-end-state" wx:if="{{ isEnd && list.length > 0 }}">已无更多</view>
</view>
<van-toast id="van-toast" />
