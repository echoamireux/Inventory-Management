<!--pages/admin-logs/index.wxml-->
<view class="page-container">
  <van-tabs active="{{ activeTab }}" bind:change="onTabChange" color="#1989fa" sticky>
    <van-tab title="库存流水" name="inventory"></van-tab>
    <van-tab title="管理审计" name="audit"></van-tab>
  </van-tabs>

  <!-- 搜索栏 -->
  <view class="search-transparent">
    <van-search
        value="{{ searchVal }}"
        placeholder="{{ searchPlaceholder }}"
        shape="round"
        bind:search="onSearch"
        bind:change="onSearchChange"
        bind:clear="onClear"
    />
  </view>

  <van-dropdown-menu active-color="#1989fa">
    <van-dropdown-item value="{{ dateFilter }}" options="{{ dateOptions }}" bind:change="onDateFilterChange" />
    <van-dropdown-item wx:if="{{ activeTab === 'audit' }}" value="{{ domainFilter }}" options="{{ domainOptions }}" bind:change="onDomainFilterChange" />
    <van-dropdown-item value="{{ typeFilter }}" options="{{ typeOptions }}" bind:change="onTypeFilterChange" />
    <van-dropdown-item value="{{ operatorFilter }}" options="{{ operatorOptions }}" bind:change="onOperatorFilterChange" />
  </van-dropdown-menu>

  <!-- 日志列表 -->
  <view class="list-container">
    <block wx:if="{{ list.length > 0 }}">
      <view wx:for="{{ list }}" wx:key="_id">
        <log-item wx:if="{{ activeTab === 'inventory' }}" item="{{ item }}" mode="full" bind:requestcorrection="onRequestCorrection" />
        <log-item wx:else item="{{ item }}" mode="full" />
      </view>
    </block>

    <van-empty wx:if="{{ !loading && list.length === 0 }}" description="暂无记录" />

    <view wx:if="{{ loading }}" class="loading-container">
      <van-loading size="24px">加载中...</van-loading>
    </view>

    <view wx:if="{{ isEnd && list.length > 0 }}" class="list-end-state">
      已无更多
    </view>
  </view>
</view>
